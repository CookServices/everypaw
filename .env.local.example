# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Secret for the custom Auth Hook (Supabase Dashboard > Auth > Hooks > Send Email)
# Generate with: openssl rand -hex 32
# If missing, the hook returns 401 and Supabase returns 500 on signup/reset.
SUPABASE_HOOK_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Legacy price ID (keep until old subscribers migrate)
STRIPE_PRICE_ID=price_...

# New plans — generated by scripts/stripe-create-products.ts
STRIPE_PRICE_DIGITAL_MONTHLY=price_...
STRIPE_PRICE_PRINT_MONTHLY=price_...
STRIPE_PRICE_PRINT_ANNUAL=price_...
STRIPE_PRICE_BOOK_ONCE=price_...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Print (Gelato) ────────────────────────────────────────────────────────────
GELATO_API_KEY=...
