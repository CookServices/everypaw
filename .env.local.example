# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Secret for the custom Auth Hook (Supabase Dashboard > Auth > Hooks > Send Email)
# Generate with: openssl rand -hex 32
# If missing, the hook returns 401 and Supabase returns 500 on signup/reset.
SUPABASE_HOOK_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Legacy price ID (keep until old subscribers migrate)
STRIPE_PRICE_ID=price_...

# Subscription price IDs — names MUST match those read in src/lib/stripe-helpers.ts,
# src/lib/plan.ts and the Stripe webhook. A missing/misnamed var makes checkout 400
# and makes the webhook fall back to metadata for the plan.
STRIPE_PRICE_ID_DIGITAL_EUR=price_...
STRIPE_PRICE_ID_DIGITAL_USD=price_...
STRIPE_PRICE_ID_DIGITAL_ANNUAL_EUR=price_...
STRIPE_PRICE_ID_DIGITAL_ANNUAL_USD=price_...
STRIPE_PRICE_ID_PRINT_EUR=price_...
STRIPE_PRICE_ID_PRINT_USD=price_...
# Print annual: single price, or EUR/USD split (either the shared or the split vars work)
STRIPE_PRICE_PRINT_ANNUAL=price_...
STRIPE_PRICE_PRINT_ANNUAL_EUR=price_...
STRIPE_PRICE_PRINT_ANNUAL_USD=price_...

# One-off extra book purchase is priced dynamically (no price ID needed).

# Legacy monthly price IDs, still mapped in priceIdToPlan() for old subscribers
STRIPE_PRICE_DIGITAL_MONTHLY=price_...
STRIPE_PRICE_PRINT_MONTHLY=price_...

# Gift purchase price IDs (src/app/api/gift/checkout/route.ts) + 100%-off coupon
STRIPE_GIFT_PRICE_ID_DIGITAL_EUR=price_...
STRIPE_GIFT_PRICE_ID_DIGITAL_USD=price_...
STRIPE_GIFT_PRICE_ID_PRINT_EUR=price_...
STRIPE_GIFT_PRICE_ID_PRINT_USD=price_...
STRIPE_GIFT_COUPON_ID=...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret signing the short-lived PDF access token (src/lib/pdf-token.ts).
# Falls back to SUPABASE_SERVICE_ROLE_KEY if unset. Generate: openssl rand -hex 32
PDF_ACCESS_SECRET=

# Bearer secret for Vercel cron routes (min 32 chars). openssl rand -hex 32
CRON_SECRET=

# Optional: internal address notified on new waitlist signups
WAITLIST_TO_EMAIL=

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Print (Gelato) ────────────────────────────────────────────────────────────
GELATO_API_KEY=...
